<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/KartDefteri.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Server/**/*.cs" />
    <EmbeddedResource Include="Assets/KartDefteri.ico" LogicalName="KartDefteri.Icon" />
    <EmbeddedResource Include="Assets/Hatirlatma.wav" LogicalName="KartDefteri.Alarm" />
  </ItemGroup>
</Project>


